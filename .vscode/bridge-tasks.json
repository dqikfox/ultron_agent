{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Copilot-AmazonQ Bridge",
      "type": "shell",
      "command": "python",
      "args": ["copilot_amazon_q_bridge.py", "--listen"],
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^\\[ERROR\\].*",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\[.*\\] Listening for workflows",
          "endsPattern": "^\\[.*\\] Bridge stopped"
        }
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "Test Bridge (Demo Mode)",
      "type": "shell",
      "command": "python",
      "args": ["copilot_amazon_q_bridge.py", "--demo"],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "new"
      },
      "group": {
        "kind": "test",
        "isDefault": false
      }
    }
  ]
}
