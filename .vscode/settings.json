{
    "files.exclude": {
        "**/node_modules": true,
        "**/__pycache__": true,
        "**/.pytest_cache": true,
        "**/.mypy_cache": true,
        "**/*.pyc": true,
        "**/screenshot_*.png": true,
        "**/ultron_screenshot_*.png": true,
        "**/ultron_region_screenshot_*.png": true,
        "**/*.log": true,
        "**/.cache/": true,
        "**/.snapshots/": true,
        "**/actions_*.json": true,
        "**/*backup*": true,
        "**/*bak*": true,
        "**/*.vsix": true
    },
    "search.exclude": {
        "**/node_modules": true,
        "**/__pycache__": true,
        "**/.pytest_cache": true,
        "**/*.log": true,
        "**/debug_logs/": true,
        "**/logs/": true,
        "**/cache/": true,
        "**/automated_files/": true,
        "**/archive/": true,
        "**/resources/": true,
        "**/docs/": true,
        "**/public/": true,
        "**/static/": true,
        "**/images/": true,
        "**/web_gui/": true,
        "**/supabase/": true,
        "**/core/": true,
        "**/src/": true,
        "**/assistant/": true,
        "**/ultron_agent/": true,
        "**/ultron_assistant/": true,
        "**/ultron_addons/": true,
        "**/tools/": true,
        "**/utils/": true,
        "**/tests/": true,
        "**/addons/": true,
        "**/new pokedex/": true,
        "**/pokedex-portfolio/": true,
        "**/gui/": true,
        "**/gateway/": true,
        "**/scripts/": true
    },
    "files.watcherExclude": {
        "**/node_modules/**": true,
        "**/__pycache__/**": true,
        "**/.pytest_cache/**": true,
        "**/*.log": true,
        "**/debug_logs/**": true,
        "**/logs/**": true,
        "**/cache/**": true,
        "**/automated_files/**": true,
        "**/archive/**": true,
        "**/resources/**": true,
        "**/docs/**": true,
        "**/public/**": true,
        "**/static/**": true,
        "**/images/**": true,
        "**/web_gui/**": true,
        "**/supabase/**": true,
        "**/core/**": true,
        "**/src/**": true,
        "**/assistant/**": true,
        "**/ultron_agent/**": true,
        "**/ultron_assistant/**": true,
        "**/ultron_addons/**": true,
        "**/tools/**": true,
        "**/utils/**": true,
        "**/tests/**": true,
        "**/addons/**": true,
        "**/new pokedex/**": true,
        "**/pokedex-portfolio/**": true,
        "**/gui/**": true,
        "**/gateway/**": true,
        "**/scripts/**": true,
        "**/screenshot_*.png": true,
        "**/ultron_screenshot_*.png": true,
        "**/ultron_region_screenshot_*.png": true,
        "**/actions_*.json": true,
        "**/*backup*": true,
        "**/*bak*": true
    },
    "python.analysis.extraPaths": ["./"],
    "python.analysis.autoImportCompletions": true,
    "python.analysis.typeCheckingMode": "basic",
    "python.analysis.autoSearchPaths": false,
    "python.linting.enabled": false,
    "python.linting.pylintEnabled": false,
    "python.linting.flake8Enabled": false,
    "python.linting.mypyEnabled": false,
    "editor.inlineSuggest.enabled": true,
    "editor.suggest.showSuggestions": true,
    "editor.suggest.showWords": true,
    "editor.quickSuggestions": {
        "other": true,
        "comments": true,
        "strings": true
    },
    "editor.acceptSuggestionOnEnter": "smart",
    "editor.codeActionsOnSave": {},
    "extensions.experimental.affinity": {
        "sixth.sixth-ai": 1
    },
    "amazonQ.telemetry": false,
    "amazonQ.shareCodeWhispererContentWithAWS": false,
    "amazonQ.suppressPrompts": {
        "amazonQChatDisclaimer": true,
        "amazonQChatPairProgramming": true
    },
    "github.copilot.enable": {
        "*": true,
        "plaintext": false,
        "markdown": true,
        "python": true,
        "javascript": true,
        "typescript": true,
        "json": true,
        "yaml": true,
        "html": true,
        "css": true,
        "sql": true,
        "shellscript": true,
        "dockerfile": true,
        "makefile": true,
        "xml": true,
        "toml": true,
        "ini": true,
        "properties": true,
        "log": false
    },
    "github.copilot.nextEditSuggestions.enabled": true,
    "github.copilot.chat.enabled": true,
    "github.copilot.inlineSuggest.enable": true,
    "github.copilot.advanced": {
        "enabled": true,
        "inlineSuggestCount": 3,
        "listSuggestion": true
    },
    "github.copilot.editor.enableAutoCompletions": true,
    "github.copilot.editor.iterativeImprovement": true,
    "github.copilot.conversation.mode": "agent"
    "http.proxySupport": "override",
    "http.systemCertificates": true,
    "search.followSymlinks": false,
    "workbench.editor.enablePreview": false,
    "workbench.editor.limit.enabled": true,
    "workbench.editor.limit.value": 10,
    "workbench.editor.limit.perEditorGroup": true,
    "files.maxMemoryForLargeFilesMB": 1024,
    "search.maxResults": 10000,
    "editor.largeFileOptimizations": true,
    "typescript.preferences.includePackageJsonAutoImports": "off",
    "javascript.preferences.includePackageJsonAutoImports": "off",
    "python.pythonPath": ".venv\\Scripts\\python.exe"
}
