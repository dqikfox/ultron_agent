{
    "editor.inlineSuggest.enabled": true,
    "editor.suggest.preview": true,
    "http.proxySupport": "override",
    "http.systemCertificates": true,
    "search.followSymlinks": false,

    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/node_modules/**": true,
        "**/venv/**": true,
        "**/.venv/**": true,
        "**/.venv-1/**": true,
        "**/__pycache__/**": true,
        "**/logs/**": true,
        "**/cache/**": true,
        "**/.cache/**": true,
        "**/screenshots/**": true,
        "**/*.png": true,
        "**/*.jpg": true,
        "**/*.jpeg": true,
        "**/*.mp3": true,
        "**/resources/agent workspaces/**": true,
        "**/ultron_addons/**": true,
        "**/Oracle_JDK-24/**": true
    },

    "typescript.preferences.maxTsServerMemory": 4096,
    "typescript.tsserver.maxTsServerMemory": 4096,
    "python.analysis.memory.keepLibraryAst": false,

    "github.copilot.enable": {
        "*": true,
        "plaintext": true,
        "markdown": true,
        "python": true,
        "javascript": true,
        "typescript": true,
        "json": true,
        "yaml": true,
        "html": true,
        "css": true,
        "sql": true,
        "shellscript": true
    },
    "github.copilot.chat.enabled": true,
    "github.copilot.inlineSuggest.enable": true,
    "github.copilot.editor.enableAutoCompletions": true,

    "amazonQ.telemetry": true,
    "amazonQ.shareCodeWhispererContentWithAWS": false,
    "ai-toolkit.enabled": true,
    "CodeGPT.enabled": false,

    "python.defaultInterpreterPath": ".venv/Scripts/python.exe",
    "python.analysis.typeCheckingMode": "basic",
    "python.formatting.provider": "black",
    "python.analysis.autoImportCompletions": true,
    "python.analysis.indexing": true,
    "python.terminal.useEnvFile": true,

    "editor.formatOnSave": false,
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "editor.minimap.enabled": false,
    "editor.codeLens": false,
    "editor.hover.delay": 1000,

    "chat.agent.maxRequests": 10000,

    "files.readonlyInclude": {
        "{**/.c4z/.extsrcs/*.PROTSYM.cbl,**/.c4z/.extsrcs/*.PROTSYM.listing}": true,
        "**/logs/**": true
    },
    "python-envs.pythonProjects": [
        {
            "path": "",
            "envManager": "ms-python.python:system",
            "packageManager": "ms-python.python:pip"
        }
    ],
    "python.testing.unittestArgs": [
        "-v",
        "-s",
        ".",
        "-p",
        "*test.py"
    ],
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": true,
    "github.copilot.nextEditSuggestions.enabled": true,
    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "amazonQ.suppressPrompts": {
        "createCredentialsProfile": true,
        "codeWhispererNewWelcomeMessage": true,
        "codeWhispererConnectionExpired": true,
        "amazonQWelcomePage": true,
        "amazonQSessionConfigurationMessage": true,
        "minIdeVersion": true,
        "ssoCacheError": true,
        "amazonQLspManifestMessage": true,
        "amazonQWorkspaceLspManifestMessage": true,
        "amazonQChatDisclaimer": true,
        "amazonQChatPairProgramming": true,
        "amazonQSelectDeveloperProfile": true
    },
    "amazonQ.allowFeatureDevelopmentToRunCodeAndTests": true,
    "amazonQ.autoApproveCommands": true,
    "amazonQ.autoApproveFileChanges": true,
    "amazonQ.confirmBeforeRunningCommands": false,
    "amazonQ.allowFullFileSystemAccess": true,
    "amazonQ.allowWriteAccess": true,
    "amazonQ.allowAdminAccess": true,
    "amazonQ.allowCodeExecution": true,
    "amazonQ.allowTerminalAccess": true,
    "amazonQ.autoRun": {
        "enabled": true,
        "commands": [
            "search tor for latest news in ai",
            "start web interface",
            "system status",
            "check ollama status"
        ],
        "runOnStartup": true,
        "delaySeconds": 3
    },
    "task.autoDetect": "on",
    "task.quickOpen.history": 10,
    "task.slowProviderWarning": false,
    "workbench.action.tasks.runTask": "Amazon Q Auto-Run",
    "chatgpt.runCodexInWindowsSubsystemForLinux": true,
    "azureFunctions.deploySubpath": "azure_functions",
    "azureFunctions.scmDoBuildDuringDeployment": true,
    "azureFunctions.pythonVenv": ".venv",
    "azureFunctions.projectLanguage": "Python",
    "azureFunctions.projectRuntime": "~4",
    "debug.internalConsoleOptions": "neverOpen",
    "workbench.colorCustomizations": {
