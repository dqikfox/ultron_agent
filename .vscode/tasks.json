{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Amazon Q Auto-Run",
            "type": "shell",
            "command": "python",
            "args": ["amazon_q_startup.py"],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "runOptions": {
                "runOn": "folderOpen"
            },
            "problemMatcher": []
        },
        {
            "label": "ULTRON Quick Start",
            "type": "shell", 
            "command": "python",
            "args": ["main.py"],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "dependsOn": "Amazon Q Auto-Run"
        }
    ]
}