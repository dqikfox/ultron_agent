{
  "folders": [
    {
      "path": "."
    }
  ],
  "settings": {
    "editor.inlineSuggest.enabled": true,
    "editor.suggest.preview": true,
    "http.proxySupport": "override",
    "http.systemCertificates": true,
    "search.followSymlinks": false,
    "typescript.preferences.maxTsServerMemory": 2048,
    "typescript.tsserver.maxTsServerMemory": 2048,
    "python.analysis.memory.keepLibraryAst": false,
    "github.copilot.enable": {
      "*": true,
      "python": true,
      "json": true,
      "markdown": true,
      "yaml": true,
      "html": true,
      "javascript": true,
      "typescript": true,
      "css": true,
      "sql": true,
      "shellscript": true,
      "plaintext": true,
      "scminput": true
    },
    "github.copilot.chat.enabled": true,
    "github.copilot.inlineSuggest.enable": true,
    "github.copilot.editor.enableAutoCompletions": true,
    "amazonQ.telemetry": false,
    "amazonQ.shareCodeWhispererContentWithAWS": false,
    "python.analysis.extraPaths": [
      "./"
    ],
    "python.analysis.autoImportCompletions": false,
    "python.analysis.typeCheckingMode": "basic",
    "python.analysis.autoSearchPaths": false,
    "python.analysis.diagnosticMode": "openFilesOnly",
    "python.analysis.indexing": false,
    "editor.suggest.showWords": false,
    "editor.minimap.enabled": false,
    "editor.codeLens": false,
    "editor.hover.delay": 1000,
    "editor.quickSuggestions": {
      "other": false,
      "comments": false,
      "strings": false
    },
    "files.associations": {
      "*.py": "python",
      "*.json": "jsonc",
      "*.yaml": "yaml"
    },
    "search.exclude": {
      "**/__pycache__": true,
      "**/node_modules": true,
      "**/.git": true,
      "**/venv": true,
      "**/env": true,
      "**/*.pyc": true,
      "**/logs/**": true,
      "**/cache/**": true,
      "**/.cache/**": true,
      "**/screenshots/**": true,
      "**/*.png": true,
      "**/*.jpg": true,
      "**/*.mp3": true,
      "**/resources/agent workspaces/**": true,
      "**/Oracle_JDK-24/**": true
    },

    "files.watcherExclude": {
      "**/.git/objects/**": true,
      "**/.git/subtree-cache/**": true,
      "**/node_modules/**": true,
      "**/venv/**": true,
      "**/__pycache__/**": true,
      "**/*.pyc": true,
      "**/logs/**": true,
      "**/cache/**": true,
      "**/.cache/**": true,
      "**/screenshots/**": true,
      "**/*.png": true,
      "**/*.jpg": true,
      "**/*.jpeg": true,
      "**/*.mp3": true,
      "**/resources/agent workspaces/**": true,
      "**/ultron_addons/**": true,
      "**/Oracle_JDK-24/**": true
    },
    "python.defaultInterpreterPath": "python",
    "python.formatting.provider": "black",
    "python.linting.enabled": false,
    "python.linting.pylintEnabled": false,
    "python.linting.flake8Enabled": false,
    "editor.formatOnSave": false,
    "editor.codeActionsOnSave": {},

    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "workbench.colorTheme": "Default Dark+",
    "workbench.iconTheme": "vs-seti",
    "terminal.integrated.defaultProfile.windows": "PowerShell",
    "yaml.schemas": {
      "file:///home/ultro/.vscode/extensions/continue.continue-1.2.11-linux-x64/config-yaml-schema.json": [
        ".continue/**/*.yaml",
        "file:///home/ultro/.continue/config.yaml"
      ],
      "file:///c%3A/Users/ultro/.vscode/extensions/continue.continue-1.2.9-win32-x64/config-yaml-schema.json": [
        ".continue/**/*.yaml",
        "file:///c%3A/Projects/ultron_agent/.continue/agents/new-agent-1.yaml"
      ]
    },
    "github.copilot.nextEditSuggestions.enabled": true,
    "amazonQ.allowFeatureDevelopmentToRunCodeAndTests": {

    },
    "chat.agent.maxRequests": 250,
    "markdown.validate.enabled": true
  },
  "extensions": {
    "recommendations": [
      "github.copilot",
      "github.copilot-chat",
      "ms-python.python"
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Start ULTRON Agent",
        "type": "shell",
        "command": "python",
        "args": ["main.py"],
        "group": "build",
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": false,
          "panel": "shared"
        }
      }
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Python: Current File",
        "type": "debugpy",
        "request": "launch",
        "program": "${file}",
        "console": "integratedTerminal",
        "justMyCode": false,
        "env": {
          "PYTHONPATH": "${workspaceFolder}"
        }
      },
      {
        "name": "Ultron Agent: Main",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/main.py",
        "console": "integratedTerminal",
        "justMyCode": false,
        "env": {
          "PYTHONPATH": "${workspaceFolder}",
          "DEBUG": "true"
        }
      },
      {
        "name": "Python: Test Suite",
        "type": "debugpy",
        "request": "launch",
        "module": "pytest",
        "args": [
          "tests/",
          "-v",
          "--tb=short"
        ],
        "console": "integratedTerminal",
        "justMyCode": false,
        "env": {
          "PYTHONPATH": "${workspaceFolder}"
        }
      },
      {
        "type": "pwa-msedge",
        "name": "Launch Microsoft Edge",
        "request": "launch",
        "runtimeArgs": [
          "--remote-debugging-port=9222"
        ],
        "url": "/home/ultro/.vscode/extensions/ms-edgedevtools.vscode-edge-devtools-2.1.10/out/startpage/index.html",
        "presentation": {
          "hidden": true
        }
      },
      {
        "type": "pwa-msedge",
        "name": "Launch Microsoft Edge in headless mode",
        "request": "launch",
        "runtimeArgs": [
          "--headless",
          "--remote-debugging-port=9222"
        ],
        "url": "/home/ultro/.vscode/extensions/ms-edgedevtools.vscode-edge-devtools-2.1.10/out/startpage/index.html",
        "presentation": {
          "hidden": true
        }
      },
      {
        "type": "vscode-edge-devtools.debug",
        "name": "Open Edge DevTools",
        "request": "attach",
        "url": "/home/ultro/.vscode/extensions/ms-edgedevtools.vscode-edge-devtools-2.1.10/out/startpage/index.html",
        "presentation": {
          "hidden": true
        }
      },
      {
        "name": "Attach to Python Functions",
        "type": "debugpy",
        "request": "attach",
        "connect": {
          "host": "localhost",
          "port": 9091
        },
        "preLaunchTask": "func: host start"
      }
    ],
    "compounds": [
      {
        "name": "Launch Edge Headless and attach DevTools",
        "configurations": [
          "Launch Microsoft Edge in headless mode",
          "Open Edge DevTools"
        ]
      },
      {
        "name": "Launch Edge and attach DevTools",
        "configurations": [
          "Launch Microsoft Edge",
          "Open Edge DevTools"
        ]
      }
    ]
  }
}
