# Ollama
OLLAMA_API_KEY=your_ollama_key_here

# ElevenLabs
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# Google Cloud
GOOGLE_APPLICATION_CREDENTIALS=path_to_your_service_account_json
GEMINI_API_KEY=your_gemini_key_here

# Logging (if needed)
LOGFLARE_LOGGER_BACKEND_API_KEY=your_logflare_backend_key_here
LOGFLARE_API_KEY=your_logflare_key_here

# GitHub MCP Server
# Set runtime to either "remote" (GitHub-hosted MCP) or "local" (self-hosted container)
GITHUB_MCP_RUNTIME=remote
# Required when using the remote GitHub MCP server; generate a classic PAT with repo/read scope
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_pat_here
# Override if running a local MCP container (default GitHub API endpoint shown)
GITHUB_HOST=https://api.github.com
# Comma-separated list of GitHub toolsets to enable in MCP (issues, pullRequests, repositories, etc.)
GITHUB_TOOLSETS=issues,pullRequests,repositories
# Leave true to prevent write operations via MCP
GITHUB_READ_ONLY=true
# Enable if you want MCP to auto-load toolsets based on the active repo context
GITHUB_DYNAMIC_TOOLSETS=false
# Optional: scope requests to an organization or user namespace
GITHUB_DEFAULT_ORG=your-org-or-username
