{
  "name": "ultron-agent-command-center",
  "version": "1.0.0",
  "description": "AI Agent Command Center with Ultron theme for Windows 10",
  "main": "dist-electron/main.js",
  "author": "MiniMax Agent",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build-electron": "tsc -p electron/tsconfig.json",
    "dev": "npm run build-electron && concurrently \"vite\" \"wait-on tcp:5173 && electron dist-electron/main.js\"",
    "build": "npm run build-electron && vite build",
    "electron:dev": "npm run build-electron && concurrently \"vite\" \"wait-on tcp:5173 && electron dist-electron/main.js\"",
    "electron:pack": "npm run build && electron-builder",
    "electron:dist": "npm run build && electron-builder --publish=never",
    "electron:dir": "npm run build && electron-builder --dir",
    "preelectron:pack": "npm run build",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "build": {
    "appId": "com.minimax.ultron-agent",
    "productName": "Ultron Agent Command Center",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.8.3",
    "@electron-forge/maker-deb": "^7.8.3",
    "@electron-forge/maker-rpm": "^7.8.3",
    "@electron-forge/maker-squirrel": "^7.8.3",
    "@electron-forge/maker-zip": "^7.8.3",
    "@electron-forge/plugin-auto-unpack-natives": "^7.8.3",
    "@electron-forge/plugin-fuses": "^7.8.3",
    "@electron/fuses": "^1.8.0",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^41.2.0",
    "typescript": "^5.3.3",
    "vite": "^8.0.8",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "electron-squirrel-startup": "^1.0.1",
    "electron-store": "^8.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ws": "^8.16.0"
  }
}
