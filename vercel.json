{
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "env": {
    "LOG_LEVEL": "info",
    "ENV": "production"
  },
  "installCommand": "pip install -r requirements_vercel.txt"
}
