# =============================================================================
# LOGGING & MONITORING
# =============================================================================

# Logflare - Centralized logging service
LOGFLARE_API_KEY=your_logflare_api_key_here
LOGFLARE_LOGGER_BACKEND_API_KEY=your_logflare_backend_key_here

# =============================================================================
# DEVELOPMENT & INTEGRATION TOOLS
# =============================================================================

# GitHub - Repository access and CI/CD integration
GITHUB_TOKEN=your_github_token_here

# Postman - API testing and documentation
POSTMAN_API=your_postman_api_key_here

# PetShop API - Additional service integration
PETSHOP_APIKEY=your_petshop_api_key_here

# Google Cloud - Additional Google services
GOOGLE_API_KEY_ULTRON=your_google_api_key_ultron_here

# Google Cloud Credentials - Service account JSON path
GOOGLE_APPLICATION_CREDENTIALS=path_to_your_service_account_json

# =============================================================================
# GITHUB MCP SERVER CONFIGURATION
# =============================================================================

# Runtime mode for GitHub MCP server (remote hosted vs local container)
GITHUB_MCP_RUNTIME=remote

# Personal Access Token used by the MCP server (should be read-only repo scope)
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_pat_here

# Base URL for MCP transport (override when running a local container)
GITHUB_HOST=https://api.github.com

# Comma-separated GitHub toolsets exposed through MCP (issues, PRs, repos, etc.)
GITHUB_TOOLSETS=issues,pullRequests,repositories

# Keep true to disable mutation APIs via MCP unless explicitly required
GITHUB_READ_ONLY=true

# Enable to auto-select toolsets based on active repository context
GITHUB_DYNAMIC_TOOLSETS=false

# Optional default organization/user namespace for MCP calls
GITHUB_DEFAULT_ORG=your-org-or-username

# =============================================================================
# SYSTEM CONFIGURATION
# =============================================================================

# GUI Server Port - Web interface port (default: 5000)
ULTRON_GUI_PORT=5000

# Debug Mode - Enable/disable debug logging (0=off, 1=on)
ULTRON_DEBUG=0

# =============================================================================
# ADDITIONAL CONFIGURATION NOTES
# =============================================================================
# - All API keys should be obtained from their respective service providers
# - Never commit actual API keys to version control
# - Use environment variables for sensitive data instead of hardcoded values
# - Test all integrations after updating keys
# - Follow comprehensive-editing.prompt.md for any code modifications
# - Ensure model awareness and centralized logging are maintained
