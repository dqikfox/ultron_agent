# OpenAI
OPENAI_API_KEY=your_openai_key_here

# NVIDIA API Keys (comma-separated for multiple keys)
NVIDIA_API_KEYS=your_nvidia_key_1,your_nvidia_key_2
NVIDIA_API_KEY=your_nvidia_key_here

# Ollama
OLLAMA_API_KEY=your_ollama_key_here

# ElevenLabs
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# Google Cloud
GOOGLE_APPLICATION_CREDENTIALS=path_to_your_service_account_json
GEMINI_API_KEY=your_gemini_key_here

# Logging (if needed)
LOGFLARE_LOGGER_BACKEND_API_KEY=your_logflare_backend_key_here
LOGFLARE_API_KEY=your_logflare_key_here

# Security Settings
REQUIRE_ADMIN_CONFIRMATION=true
LOG_ALL_COMMANDS=true
DANGEROUS_COMMANDS_ENABLED=false