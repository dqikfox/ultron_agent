import sys
sys.path.append('.')
from voice_manager import UltronVoiceManager
vm = UltronVoiceManager()
print('ElevenLabs available:', 'elevenlabs' in vm.engines and vm.engines['elevenlabs'] is not None)
print('Testing TTS engines...')
try:
    result = vm.test_engine('elevenlabs')
    print(f'ElevenLabs test result: {result}')
except Exception as e:
    print(f'ElevenLabs test failed: {e}')
